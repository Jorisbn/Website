---
const { name } = Astro.props;
import { navigation } from "@/data/navigation";
import packageJson from "../../../package.json";
---

<footer class="relative bg-black border-t border-cyan-500/20 overflow-hidden z-10">
    <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-t from-cyber-dark via-black to-transparent opacity-50"></div>
        <div
            class="absolute inset-0"
            style="background-image: radial-gradient(circle at 1px 1px, rgba(6, 182, 212, 0.1) 1px, transparent 0px); background-size: 40px 40px;"
        >
        </div>
        <div
            class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-cyan-400 to-transparent"
            style="transform: scaleX(0.970479); opacity: 0.485239;"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 py-12 relative z-10">
        <div class="grid md:grid-cols-4 gap-8 mb-8">
            <div class="md:col-span-2">
                <div class="mb-6">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="relative">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="lucide lucide-terminal w-8 h-8 text-cyan-400"
                                aria-hidden="true"
                            >
                                <path d="M12 19h8"></path>
                                <path d="m4 17 6-6-6-6"></path>
                            </svg>

                            <div
                                class="absolute inset-0 bg-cyan-400/20 rounded-full blur-md"
                                style="transform: scale(1.02978);"
                            >
                            </div>
                        </div>

                        <div>
                            <h3 class="text-2xl font-bold bg-gradient-to-r from-cyan-400 to-purple-400 bg-clip-text text-transparent">{name}</h3>
                        </div>
                    </div>

                    <p class="text-gray-300 leading-relaxed mb-4">Full-stack developer met focus op moderne websites en webapplicaties gebouwd met React, Next.js, Typescript, MongoDB en PostgreSQL.</p>
                </div>
            </div>

            <div>
                <div>
                    <h4 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="lucide lucide-code w-5 h-5 text-cyan-400"
                            aria-hidden="true"
                        >
                            <path d="m16 18 6-6-6-6"></path>
                            <path d="m8 6-6 6 6 6"></path>
                        </svg>

                        Navigation
                    </h4>

                    <nav class="flex flex-col gap-2">
                        {
                            navigation.map((item) => (
                                <a
                                    href={item.href}
                                    aria-label={item.label}
                                    class="block text-gray-400 hover:text-cyan-400 transition-colors text-left font-mono text-sm"
                                >
                                    <span class="text-cyan-400">&gt;</span>
                                    {item.text}
                                </a>
                            ))
                        }
                    </nav>
                </div>
            </div>
        </div>

        <div class="border-t border-cyan-500/20 pt-8 mt-8">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-2 text-gray-400 font-mono text-sm">
                    <span>&copy; 2024 {name}</span>
                    <span class="text-cyan-400">|</span>
                    <span>BUILT_WITH</span>
                    <span class="text-purple-500">ASTRO</span>
                </div>

                <div class="flex items-center gap-4 text-sm font-mono">
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                        <span class="text-gray-400">WEBSITE_ONLINE</span>
                    </div>

                    <span class="text-cyan-400">v{packageJson.version}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="absolute bottom-0 left-0 w-20 h-20 border-l-2 border-b-2 border-cyan-500/20"></div>
    <div class="absolute bottom-0 right-0 w-20 h-20 border-r-2 border-b-2 border-purple-500/20"></div>
</footer>
