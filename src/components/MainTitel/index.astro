---
const { title } = Astro.props;
---

<h2 class="text-3xl md:text-6xl font-mono font-bold mb-6">
    <span class="text-cyan-400">&lt;</span>
    <span class="bg-gradient-to-r from-cyan-400 via-purple-500 to-pink-500 bg-clip-text text-transparent">{title}</span>
    <span class="text-pink-500">/&gt;</span>
</h2>
