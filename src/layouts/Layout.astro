---
import "../styles/global.css";

import { DiagonalBackground } from "@/components";
import { Head, Header, Footer } from "@/globals";

const { name } = Astro.props;
---

<!doctype html>
<html
    lang="en"
    class="scroll-smooth"
>
    <Head />

    <body class="bg-black">
        <DiagonalBackground />

        <Header name={name} />

        <main class="relative z-10">
            <slot />
        </main>

        <Footer name={name} />
    </body>
</html>
