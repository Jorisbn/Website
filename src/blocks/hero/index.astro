---
const { name } = Astro.props;
---

<section
    id="top"
    class="min-h-screen flex items-center justify-center relative overflow-hidden pt-20"
    id="home"
>
    <div class="max-w-7xl mx-auto px-6 py-16 relative z-10">
        <div class="grid gap-12 items-center">
            <div class="text-center">
                <div class="mb-8">
                    <h1 class="text-5xl md:text-7xl font-bold text-white mb-6">
                        Hi, Ik ben <span class="bg-gradient-to-r from-cyan-400 to-purple-400 bg-clip-text text-transparent">{name}</span>
                        {/* Hi, Ik ben <span class="bg-gradient-to-r from-cyan-300 via-rose-200 to-cyan-300 bg-clip-text text-transparent">{name}</span> */}
                    </h1>

                    <div class="mb-8">
                        <p class="text-2xl md:text-3xl text-gray-300 mb-4">
                            Ik ben een <span class="text-cyan-400 font-semibold">Full-stack Developer</span>
                        </p>

                        <p class="text-lg text-gray-400 max-w-2xl">Full-stack developer met focus op moderne websites en webapplicaties gebouwd met React, Next.js, Typescript, MongoDB en PostgreSQL.</p>
                    </div>

                    <div class="flex flex-col sm:flex-row justify-start sm:justify-center gap-4 mb-12">
                        <a
                            href="#projects"
                            class="px-8 py-4 bg-gradient-to-r from-cyan-500 to-purple-500 text-white rounded-lg font-semibold hover:from-cyan-600 hover:to-purple-600 transition-all transform hover:scale-105"
                            tabindex="0"
                        >
                            Bekijk mijn projecten
                        </a>
                    </div>
                    <div class="flex justify-center gap-6">
                        <a
                            href="https://github.com/Jorisbn"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-gray-400 hover:text-gray-300 transition-colors"
                            tabindex="0"
                            aria-label="Mijn Github"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="lucide lucide-github"
                                aria-hidden="true"
                            >
                                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                                <path d="M9 18c-4.51 2-5-2-7-2"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2">
            <a
                href="#about"
                class="text-cyan-400 flex flex-col items-center"
            >
                <span class="text-sm font-mono mb-2">SCROLL</span>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-arrow-down"
                    aria-hidden="true"
                >
                    <path d="M12 5v14"></path>
                    <path d="m19 12-7 7-7-7"></path>
                </svg>
            </a>
        </div>
    </div>
</section>
