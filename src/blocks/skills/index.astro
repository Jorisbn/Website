---
import { skills, extraSkills } from "@/data/skills";
import { iconMap } from "@/assets/icons/iconMap";
import { MainTitle } from "@/components";
---

<section
    id="skills"
    class="py-20 relative overflow-hidden bg-black"
>
    <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-br from-cyber-dark via-black to-cyber-darker opacity-50"></div>
        <div
            class="absolute inset-0"
            style="background-image: radial-gradient(circle at 1px 1px, rgba(6, 182, 212, 0.1) 1px, transparent 0px); background-size: 50px 50px;"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-16">
            <MainTitle title="SKILLS & EXPERTISE" />
        </div>

        <div class="grid lg:grid-cols-2 xl:grid-cols-3 gap-8 mb-16">
            {
                Object.entries(skills).map(([key, skill]) => {
                    const icon = iconMap[skill.icon];

                    return (
                        <div
                            id={key}
                            class="group"
                        >
                            <div class="border border-cyan-500/20 bg-gradient-to-br from-cyan-500/5 to-purple-500/5 rounded-lg p-6 backdrop-blur-sm hover:border-cyan-500/40 transition-all duration-300 h-full">
                                <div class="flex items-center gap-3 mb-6">
                                    <div class={`p-3 rounded-lg bg-gradient-to-r ${skill.gradient} bg-opacity-20`}>
                                        <div
                                            class="text-white"
                                            set:html={icon}
                                        />
                                    </div>

                                    <h3 class="text-xl font-bold text-white group-hover:text-cyan-400 transition-">{skill.title}</h3>
                                </div>

                                <div class="flex flex-col gap-4">
                                    {skill.items.map((item) => {
                                        const codingIcon = item.icon ? iconMap[item.icon] : null;

                                        return (
                                            <div class="flex flex-col gap-2">
                                                <div class="flex items-center gap-2">
                                                    {icon && (
                                                        <span class="text-lg">
                                                            <div
                                                                class="text-white fill-white"
                                                                set:html={codingIcon}
                                                            />
                                                        </span>
                                                    )}
                                                    <span class="text-white font-medium text-sm">{item.name}</span>
                                                </div>
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>
                        </div>
                    );
                })
            }
        </div>

        <div class="text-center mt-16">
            <h3 class="text-2xl font-semibold text-white mb-8">Aanvullende technologieën &amp; hulpmiddelen</h3>

            <div class="flex flex-wrap justify-center gap-4">
                {extraSkills.map((skill) => <span class="px-4 py-2 bg-black/30 border border-gray-700 text-gray-300 rounded-lg text-sm font-medium hover:border-cyan-400 hover:text-cyan-400 transition-all duration-200 cursor-default">{skill}</span>)}
            </div>
        </div>
    </div>
</section>
